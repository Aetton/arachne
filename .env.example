# Copy to .env and adjust. docker compose reads it automatically.

# Runtime profile: dev (default), prod, or production.
ENV=dev

# Sign JWTs with this — MUST change in prod (any long random string).
JWT_SECRET=change-me-to-a-long-random-string
# TOKEN_TTL_DAYS=7

# Seeded admin password on first boot. Change immediately via the admin UI.
ADMIN_PASSWORD=change-me

# Artifact repository base URL (download links are built from this).
NEXUS_URL=https://nexus.example.internal

# Artifact upload creds — consumed by playbooks/workflows, not the portal itself.
# In production, pull these from a secret manager instead of hardcoding.
NEXUS_USER=
NEXUS_PASSWORD=

# Bus backend: inmemory (default, single process) or nats (multi-process).
BUS_BACKEND=inmemory
# NATS_URL=nats://nats:4222

# Forgejo/Gitea-compatible build backend.
FORGEJO_URL=https://forgejo.example.internal
FORGEJO_TOKEN=
FORGEJO_OWNER=example
# FORGEJO_DEADLINE=3600
# FORGEJO_POLL_INTERVAL=2
# INPUT_SOURCE_CACHE_TTL=30

# GitLab CI build backend.
GITLAB_URL=https://gitlab.example.internal
GITLAB_TOKEN=
# GITLAB_DEADLINE=3600
# GITLAB_POLL_INTERVAL=2
GITLAB_VERIFY_TLS=true

ARACHNE_URL=https://arachne.example.internal
FORGEJO_VERIFY_TLS=true

# Optional path overrides. Compose already sets these for its container.
# SCENARIOS_CONFIG=/app/config/scenarios.yaml
# ANSIBLE_PLAYBOOKS_DIR=/app/playbooks
# TOFU_ROOT=/app/tofu
# TOFU_STATE_ROOT=/var/lib/arachne/tofu-state

# -------------------------------------------------------------------------
# OpenTofu / Proxmox backend configuration
# -------------------------------------------------------------------------
# These are backend details. Scenario authors must not need them.
PROXMOX_VE_ENDPOINT=https://proxmox.example.internal:8006/
PROXMOX_VE_API_TOKEN=
PROXMOX_VE_INSECURE=false

# Logical OS -> golden template.
TOFU_TEMPLATE_REDOS7=
TOFU_TEMPLATE_REDOS8=
TOFU_TEMPLATE_WINDOWS=

# Source node for each golden template.
TOFU_TEMPLATE_REDOS7_NODE=
TOFU_TEMPLATE_REDOS8_NODE=
TOFU_TEMPLATE_WINDOWS_NODE=

# Optional common target node for clones.
TOFU_NODE_NAME=

# Optional target datastore for full clones. Empty means inherit placement.
TOFU_CLONE_DATASTORE=

# Resource override plumbing. Scenario users only write resources.cpu,
# resources.memory_gb and resources.disk_gb. The spider resolves everything below.
# Golden images currently use a 40 GiB system disk; this global default may be
# overridden per OS later without changing scenario YAML.
TOFU_DEFAULT_GOLDEN_DISK_GB=40
TOFU_SYSTEM_DISK_INTERFACE=scsi0

# Datastore of the golden image system disk. Required only if scenario authors
# are allowed to request disk_gb larger than the golden image.
TOFU_TEMPLATE_REDOS7_DISK_DATASTORE=
TOFU_TEMPLATE_REDOS8_DISK_DATASTORE=
TOFU_TEMPLATE_WINDOWS_DISK_DATASTORE=

# Optional per-OS overrides for non-standard golden images.
# TOFU_TEMPLATE_REDOS7_DISK_GB=40
# TOFU_TEMPLATE_REDOS8_DISK_GB=40
# TOFU_TEMPLATE_WINDOWS_DISK_GB=40
# TOFU_TEMPLATE_REDOS7_DISK_INTERFACE=scsi0
# TOFU_TEMPLATE_REDOS8_DISK_INTERFACE=scsi0
# TOFU_TEMPLATE_WINDOWS_DISK_INTERFACE=scsi0

# Development only.
TOFU_DEV_FALLBACK=false

POSTGRES_PASSWORD=replace-with-a-long-random-password
