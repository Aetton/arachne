# Copy to .env and adjust. docker compose reads it automatically.

# Runtime profile: dev (default), prod, or production.
ENV=dev

# Sign JWTs with this — MUST change in prod (any long random string).
JWT_SECRET=change-me-to-a-long-random-string
# TOKEN_TTL_DAYS=7

# Seeded admin password on first boot. Change immediately via the admin UI.
ADMIN_PASSWORD=change-me

# Artifact repository base URL (download links are built from this).
NEXUS_URL=https://nexus.example.internal

# Artifact upload creds — consumed by playbooks/workflows, not the portal itself.
# In production, pull these from a secret manager instead of hardcoding.
NEXUS_USER=
NEXUS_PASSWORD=

# Bus backend: inmemory (default, single process) or nats (multi-process).
BUS_BACKEND=inmemory
# NATS_URL=nats://nats:4222

# Forgejo/Gitea-compatible build backend.
FORGEJO_URL=https://forgejo.example.internal
FORGEJO_TOKEN=
FORGEJO_OWNER=example
# FORGEJO_DEADLINE=3600
# FORGEJO_POLL_INTERVAL=2
# INPUT_SOURCE_CACHE_TTL=30

# GitLab CI build backend.
GITLAB_URL=https://gitlab.example.internal
GITLAB_TOKEN=
# GITLAB_DEADLINE=3600
# GITLAB_POLL_INTERVAL=2
GITLAB_VERIFY_TLS=true

ARACHNE_URL=https://arachne.example.internal
FORGEJO_VERIFY_TLS=true

# -------------------------------------------------------------------------
# Ansible playbook repository
# -------------------------------------------------------------------------
# When ANSIBLE_PLAYBOOK_REPO_URL is set, ansible-local resolves playbooks from
# this Git repository. Git authentication is deliberately delegated to normal
# Git mechanisms: ssh-agent/deploy key, credential helper, or an authenticated
# HTTPS remote. A scenario may override only the ref via `playbook_ref`.
ANSIBLE_PLAYBOOK_REPO_URL=
ANSIBLE_PLAYBOOK_REPO_REF=main
ANSIBLE_PLAYBOOK_REPO_SUBDIR=playbooks/arachne
ANSIBLE_PLAYBOOK_CACHE_DIR=/var/cache/arachne/playbooks

# Optional path overrides. Compose already sets these for its container.
# SCENARIOS_CONFIG=/app/config/scenarios.yaml
# ANSIBLE_PLAYBOOKS_DIR=/app/playbooks  # dev fallback when repo URL is unset
# TOFU_ROOT=/app/tofu
# TOFU_STATE_ROOT=/var/lib/arachne/tofu-state

# Optional OpenTofu provider network mirror. Leave empty to use providers directly.
# Example for deployments where registry access is restricted:
# TOFU_PROVIDER_MIRROR=https://tf-proxy.selectel.ru/mirror/v1/
TOFU_PROVIDER_MIRROR=

# -------------------------------------------------------------------------
# Proxmox connection
# -------------------------------------------------------------------------
# Only connection/authentication belongs in env. Golden image mappings are
# configured in Control -> Golden Images. Node, datastore, system disk layout,
# CPU and RAM are discovered live from Proxmox by the spider.
PROXMOX_VE_ENDPOINT=https://proxmox.example.internal:8006/
PROXMOX_VE_API_TOKEN=
PROXMOX_VE_INSECURE=false

# Development only.
TOFU_DEV_FALLBACK=false

POSTGRES_PASSWORD=replace-with-a-long-random-password
